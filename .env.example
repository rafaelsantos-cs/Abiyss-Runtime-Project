# Copie este arquivo para `.env` e preencha com as suas chaves.
# O `.env` está no .gitignore: segredos NUNCA entram em commit.
#
# Os NOMES destas variáveis são definidos em `abiyss.toml`
# (campo `api_key_env` de cada pool). Se mudar lá, mude aqui também.

# Chave do NVIDIA NIM usada pelo pool do CÉREBRO (exclusivo do Abiyss).
NIM_API_KEY_CEREBRO=nvapi-COLOQUE-AQUI

# Chave do NVIDIA NIM usada pelo pool dos SUB-AGENTES.
NIM_API_KEY_SUBAGENTES=nvapi-COLOQUE-AQUI

# Nível de log (sintaxe do tracing-subscriber / EnvFilter).
RUST_LOG=abiyss=info
